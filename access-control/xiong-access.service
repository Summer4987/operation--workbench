[Unit]
Description=Xiong account and store authorization
After=network.target inventory-board.service
[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/xiong-access/current/access-control
EnvironmentFile=-/etc/inventory-board.env
EnvironmentFile=-/etc/daily-order.env
EnvironmentFile=-/etc/store-order-auth.env
Environment=ACCESS_DB=/var/lib/xiong-access/accounts.sqlite3
Environment=ACCESS_DATA_ROOT=/var/www/html/operation-workbench
ExecStart=/opt/inventory-board/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8020 --no-access-log
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xiong-access
ProtectHome=true
[Install]
WantedBy=multi-user.target
