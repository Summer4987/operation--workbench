[Unit]
Description=Inventory Board
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/inventory-board
EnvironmentFile=/etc/inventory-board.env
EnvironmentFile=-/etc/store-order-auth.env
Environment=STORE_ORDER_ACCOUNTS_FILE=/etc/store-order-accounts.json
ExecStart=/opt/inventory-board/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
