    },
    {
      "id": "franchise",
      "name": "加盟业务中心",
      "description": "合同、加盟资料、流程清单、文件生成和提醒。"
    }
  ],
  "tasks": [
    {
      "id": "ops.morning_one_click",
      "center": "operations",
      "name": "上午运营一键采集",
      "risk": "high",
      "mode": "manual_run",
      "description": "串联经营日报、评价下载、余额巡检、推广预算预览/执行和云端发布。",
      "command": ["{python}", "morning-ops/run_morning_ops.py"],
      "evidence": [
        {"path": "morning-ops/logs", "type": "directory", "freshness_hours": 36},
        {"path": "business-report-dashboard/data/latest.json", "type": "file", "freshness_hours": 36},
        {"path": "workbench-data.js", "type": "file", "freshness_hours": 36}
      ],
      "blockers": ["login", "captcha", "platform_verification", "timeout", "publish_failure"]
    },
    {
      "id": "ops.daily_report_publish",
      "center": "operations",
