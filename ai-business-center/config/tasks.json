        {"path": "business-report-dashboard/data/latest.json", "type": "file", "freshness_hours": 36},
        {"path": "business-report-dashboard/data/unified_daily.csv", "type": "file", "freshness_hours": 36},
        {"path": "business-report-dashboard/dashboard/index.html", "type": "file", "freshness_hours": 36}
