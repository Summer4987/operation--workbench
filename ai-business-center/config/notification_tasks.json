{
  "version": 1,
  "updated_at": "2026-06-30",
  "description": "Hermes/Mac mini 自动化任务通知与 dry-run 补跑策略。高风险任务只报告，不由监控脚本执行。",
  "defaults": {
    "include_in_report": true,
    "rerun_policy": {
      "auto_allowed": false,
      "mode": "report_only",
      "allowed_when": ["failed", "missing"],
      "reason": "默认只报告；只有明确标记为只读或幂等的任务才允许进入自动补跑计划。"
    }
  },
  "tasks": [
    {
      "id": "ops.morning_collection",
      "name": "上午运营一键采集",
      "risk": "high",
      "include_in_report": true,
      "human_action": "查看子步骤失败原因，人工确认后再决定是否补跑。",
      "rerun_policy": {
        "auto_allowed": false,
        "mode": "report_only",
        "allowed_when": ["failed", "missing", "attention"],
        "reason": "串联推广预算、发布等高风险动作，只报告不自动补跑。",
        "blocked_by": ["high_risk_task", "may_submit_budget_or_publish"]
      }
    },
    {
      "id": "ops.realtime_order_income",
      "name": "实时单量和营业额采集",
      "risk": "low",
      "include_in_report": true,
      "rerun_policy": {
        "auto_allowed": true,
        "mode": "dry_run_plan",
        "allowed_when": ["failed", "missing", "attention"],
        "reason": "采集与工作台数据生成可重复执行；监控 MVP 只生成 dry-run 补跑计划，不直接调用。",
        "command": ["/bin/zsh", "scripts/run_realtime_order_income.zsh"]
      }
    },
    {
      "id": "ops.daily_report",
      "name": "加盟店日报看板",
      "risk": "medium",
      "include_in_report": true,
      "rerun_policy": {
        "auto_allowed": false,
        "mode": "report_only",
        "allowed_when": ["failed", "missing", "attention"],
        "reason": "日报流程涉及平台下载和看板发布，失败时先报告，由人工确认登录态和发布时间。",
        "blocked_by": ["platform_login", "may_publish_dashboard"]
      }
    },
    {
      "id": "growth.promo_budget",
      "name": "推广预算设置全自动",
      "risk": "high",
      "include_in_report": true,
      "human_action": "先检查预算窗口、平台登录态和安全校验；没有明确指令不得真实执行。",
      "rerun_policy": {
        "auto_allowed": false,
        "mode": "report_only",
        "allowed_when": ["failed", "missing", "attention"],
        "reason": "可能保存推广预算，属于高风险动作，只报告不自动补跑。",
        "blocked_by": ["high_risk_task", "may_submit_budget"]
      }
    },
    {
      "id": "growth.promo_balance",
      "name": "推广余额巡检",
      "risk": "low",
      "include_in_report": true,
      "rerun_policy": {
        "auto_allowed": true,
        "mode": "dry_run_plan",
        "allowed_when": ["failed", "missing"],
        "reason": "余额巡检是只读采集，可重复执行；低余额本身只报告，不触发充值。",
        "command": ["{python}", "store-inspection/run_all_balances.py"]
      }
    },
    {
      "id": "growth.promo_bid",
      "name": "推广出价调整全自动",
      "risk": "high",
      "include_in_report": true,
      "rerun_policy": {
        "auto_allowed": false,
        "mode": "report_only",
        "allowed_when": ["failed", "missing", "attention"],
        "reason": "出价调整必须审批，监控只报告审批队列和失败原因。",
        "blocked_by": ["high_risk_task", "requires_approval", "may_submit_bid"]
      }
    },
    {
      "id": "flow.inventory",
      "name": "库存全自动",
      "risk": "medium",
      "include_in_report": true,
      "rerun_policy": {
        "auto_allowed": true,
        "mode": "dry_run_plan",
        "allowed_when": ["failed", "missing", "attention"],
        "reason": "库存健康检查是只读探测，可进入 dry-run 补跑计划。",
        "command": ["{python}", "scripts/check_inventory_cloud_health.py"]
      }
    },
    {
      "id": "flow.auto_ordering",
      "name": "订货全自动",
      "risk": "high",
      "include_in_report": true,
      "human_action": "只检查建议和预览，不自动下单、不付款。",
      "rerun_policy": {
        "auto_allowed": false,
        "mode": "report_only",
        "allowed_when": ["failed", "missing", "attention"],
        "reason": "订货可能产生下单或付款风险，只报告不自动补跑。",
        "blocked_by": ["high_risk_task", "may_create_order_or_payment"]
      }
    },
    {
      "id": "tools.sales_receipt",
      "name": "销售单生成器",
      "risk": "low",
      "include_in_report": true,
      "rerun_policy": {
        "auto_allowed": true,
        "mode": "dry_run_plan",
        "allowed_when": ["failed", "missing", "attention"],
        "reason": "工具状态和打印校验可本地重复生成，不触碰平台。",
        "command": ["{node}", "scripts/check_sales_receipt_print_layout.mjs"]
      }
    },
    {
      "id": "tools.franchise_contract",
      "name": "加盟合同生成器",
      "risk": "medium",
      "include_in_report": true,
      "rerun_policy": {
        "auto_allowed": false,
        "mode": "report_only",
        "allowed_when": ["failed", "missing", "attention"],
        "reason": "合同模板和条款需要人工确认，监控只报告状态。",
        "blocked_by": ["business_terms_need_review"]
      }
    }
  ]
}
