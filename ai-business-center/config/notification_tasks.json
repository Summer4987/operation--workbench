      "risk": "low",
      "morning_step": "推广预算初始化预览",
      "evidence_path": "outputs/promo_budget_preview/latest.json",
      "human_action": "先修复预算配置或门店映射，生成预览后再允许真实预算步骤。"
    },
    {
      "id": "morning.11_eleme_lunch_budget",
      "name": "饿了么午餐预算提交",
      "risk": "high",
      "morning_step": "饿了么午餐预算真实提交",
      "evidence_path": "outputs/dianjin_automation",
      "human_action": "高风险动作。失败时只报告，人工确认登录态、目标预算和页面状态后再补跑。",
      "rerun_policy": {
        "auto_allowed": false,
        "mode": "report_only",
        "reason": "会真实提交预算，只报告不自动补跑。",
        "blocked_by": ["high_risk_task", "may_submit_budget"]
      }
    },
    {
      "id": "morning.12_meituan_lunch_budget",
      "name": "美团午餐预算提交",
      "risk": "high",
      "morning_step": "美团午餐预算真实提交",
      "evidence_path": "outputs/meituan_budget_automation",
      "human_action": "高风险动作。失败时只报告，人工确认登录态、目标预算和页面状态后再补跑。",
      "rerun_policy": {
        "auto_allowed": false,
        "mode": "report_only",
        "reason": "会真实提交预算，只报告不自动补跑。",
        "blocked_by": ["high_risk_task", "may_submit_budget"]
      }
    },
    {
      "id": "morning.13_workbench_build",
      "name": "总看板数据更新",
      "risk": "low",
      "morning_step": "运营总看板数据更新",
      "evidence_path": "workbench-data.js",
      "human_action": "检查各数据源 JSON 是否生成，再重跑工作台数据构建。"
    },
    {
      "id": "morning.14_workbench_publish",
      "name": "总看板云端发布",
      "risk": "medium",
      "morning_step": "运营总看板发布腾讯云",
      "evidence_path": "workbench-data.js",
      "human_action": "检查云端 SSH/rsync 权限和发布路径；发布失败不能算早上完成。"
    }
  ],
  "excluded_from_morning_report": [
    "ops.realtime_order_income",
    "growth.promo_bid",
    "flow.inventory",
    "flow.auto_ordering",
    "tools.sales_receipt",
