    {
      "id": "morning.06_promo_balance",
      "name": "推广余额巡检",
      "risk": "low",
      "morning_step": "推广余额总巡检",
      "evidence_path": "outputs/promo_balance_status/latest.json",
      "human_action": "登录态或余额页面异常时，先重跑只读余额巡检；低余额只提醒，不自动充值。",
      "rerun_policy": {
        "auto_allowed": true,
        "mode": "dry_run_plan",
        "allowed_when": ["failed", "missing"],
        "reason": "余额巡检是只读采集，可进入补跑计划。",
        "command": ["{python}", "store-inspection/run_all_balances.py"]
      }
    },
    {
      "id": "morning.07_evidence_manifest",
      "name": "巡检证据生成",
      "risk": "low",
      "morning_step": "巡检证据清单生成",
      "evidence_path": "outputs/store_inspection_evidence_manifest/latest.json",
      "human_action": "检查巡检截图/OCR 是否存在，重跑证据清单生成。"
    },
    {
      "id": "morning.08_evidence_upload",
      "name": "巡检证据上传",
      "risk": "medium",
      "morning_step": "巡检证据上传云端",
      "evidence_path": "outputs/store_inspection_evidence_manifest/latest.json",
