{
  "version": 2,
  "updated_at": "2026-07-01",
  "description": "Hermes/Mac mini 早间自动化通知清单。早上必须完成且每天汇报的任务有且只有 14 个；工具、库存、订货、财务、出价审批、实时采集和旧 launchd 噪声不进入早报。",
  "defaults": {
    "include_in_report": true,
    "morning_required": true,
    "rerun_policy": {
      "auto_allowed": false,
      "mode": "report_only",
      "allowed_when": ["failed", "missing", "attention"],
      "reason": "早间主流程默认只报告；高风险预算、发布和平台采集不得自动补跑。"
    }
  },
  "tasks": [
    {
      "id": "morning.01_collection",
      "name": "上午运营一键采集总状态",
      "risk": "high",
      "morning_aggregate": true,
      "evidence_path": "outputs/morning_collection_status/latest.json",
      "human_action": "先看 14 个子任务里哪一项失败，再决定是否补跑；不能用总状态掩盖子任务缺失。",
      "rerun_policy": {
        "auto_allowed": false,
        "mode": "report_only",
        "reason": "总入口会串联预算和发布，只报告不自动补跑。",
        "blocked_by": ["high_risk_task", "may_submit_budget_or_publish"]
      }
    },
    {
      "id": "morning.02_chrome_environment",
      "name": "Chrome/登录环境检查",
      "risk": "medium",
      "morning_step": "启动/检查后台 Chrome",
      "evidence_path": "morning-ops/logs",
      "human_action": "在 Mac mini 打开 Chrome，确认平台后台登录态、验证码和 CDP 端口正常。"
    },
    {
      "id": "morning.03_reviews_download",
      "name": "双平台评价下载",
      "risk": "medium",
      "morning_step": "双平台评价下载",
      "evidence_path": "business-report-dashboard/data/unified_reviews.csv",
      "human_action": "恢复饿了么/美团评价页登录或页面入口后，重跑评价下载。"
    },
    {
      "id": "morning.04_franchise_daily_report",
      "name": "加盟店日报采集",
      "risk": "medium",
      "morning_step": "门店日报采集并发布",
      "evidence_path": "business-report-dashboard/data/latest.json",
      "human_action": "确认普通加盟店日报后台下载和看板生成是否成功。"
    },
    {
      "id": "morning.05_direct_daily_report",
      "name": "直营店日报采集",
      "risk": "medium",
