{
  "schema_version": "2026-06-30.finance-workspace.v2",
  "system_name": "xiongxiaoxiao_finance_workspace",
  "safety_policy": {
    "default_mode": "local_draft_only",
    "auto_confirm": false,
    "auto_publish_to_feishu": false,
    "requires_human_operator_for_confirm": true,
    "forbidden_actions": [
      "自动发布财务记录",
      "自动确认微信文本",
      "无人工确认写入正式账本",
      "无 token 时模拟飞书写入成功"
    ]
  },
  "local_files": {
    "default_base_dir": "data/finance-inbox/manual-matches",
    "drafts_jsonl": "finance_drafts.jsonl",
    "ledger_jsonl": "finance_ledger.jsonl",
    "ledger_csv": "finance_ledger.csv"
  },
  "reporting_views": [
    {
      "name": "经营驾驶舱",
      "description": "按月份汇总收入、支出、经营净额、费用率、上月净额变化和待办数量。"
    },
    {
      "name": "费用科目",
      "description": "按财务分类汇总本期费用金额和占比。"
    },
    {
      "name": "门店经营",
      "description": "按门店汇总收入、支出和经营净额。"
    },
    {
      "name": "资金渠道",
      "description": "按收付款方式汇总本期流入、流出和净额。"
    },
    {
      "name": "财务待办",
      "description": "跟踪待确认草稿、待同步飞书、同步失败、缺门店和缺交易对方记录。"
    }
  ],
  "draft_fields": [
    {
      "name": "draft_id",
      "type": "text",
      "required": true,
      "description": "本地草稿唯一 ID。"
    },
    {
      "name": "created_at",
      "type": "datetime",
      "required": true,
      "description": "草稿录入时间。"
    },
    {
      "name": "status",
      "type": "single_select",
      "required": true,
      "allowed_values": [
        "pending_confirmation",
        "confirmed_to_ledger",
        "voided"
      ],
      "description": "草稿状态；MVP 默认只生成待确认草稿。"
    },
    {
      "name": "source_channel",
      "type": "single_select",
      "required": true,
      "allowed_values": [
        "wechat_text",
        "manual"
      ],
      "description": "来源渠道。"
    },
    {
      "name": "raw_text",
      "type": "multiline_text",
      "required": true,
      "description": "原始微信财务文本，保留人工复核依据。"
    },
    {
      "name": "parsed_transaction_date",
      "type": "date",
      "required": false,
      "description": "从文本推断的业务发生日期。"
    },
    {
      "name": "parsed_direction",
      "type": "single_select",
      "required": false,
      "allowed_values": [
        "income",
        "expense",
        "transfer",
        "unknown"
      ],
      "description": "收入、支出、内部转账或未知。"
    },
    {
      "name": "parsed_amount",
      "type": "currency",
      "required": false,
      "description": "从文本识别出的金额。"
    },
    {
      "name": "parsed_currency",
      "type": "single_select",
      "required": false,
      "allowed_values": [
        "CNY"
      ],
      "description": "MVP 默认人民币。"
    },
    {
      "name": "parsed_store",
      "type": "text",
      "required": false,
      "description": "从文本推断的门店。"
    },
    {
      "name": "parsed_counterparty",
      "type": "text",
      "required": false,
      "description": "从文本推断的对方户名、供应商或平台。"
    },
    {
      "name": "parsed_category",
      "type": "single_select",
      "required": false,
      "allowed_values": [
        "platform_income",
        "procurement",
        "rent",
        "salary",
        "utility",
        "marketing",
        "refund",
        "transfer",
        "other",
        "unknown"
      ],
      "description": "初步分类，确认时可覆盖。"
    },
    {
      "name": "parse_warnings",
      "type": "multiline_text",
      "required": false,
      "description": "解析不确定项，确认前必须人工查看。"
    }
  ],
  "ledger_fields": [
    {
      "name": "ledger_id",
      "type": "text",
      "required": true,
      "feishu_field": "账本ID"
    },
    {
      "name": "draft_id",
      "type": "text",
      "required": true,
      "feishu_field": "来源草稿ID"
    },
    {
      "name": "confirmed_at",
      "type": "datetime",
      "required": true,
      "feishu_field": "确认时间"
    },
    {
      "name": "confirmed_by",
      "type": "text",
      "required": true,
      "feishu_field": "确认人"
    },
    {
      "name": "transaction_date",
      "type": "date",
      "required": true,
      "feishu_field": "业务日期"
    },
    {
      "name": "direction",
      "type": "single_select",
      "required": true,
      "allowed_values": [
        "income",
        "expense",
        "transfer"
      ],
      "feishu_field": "收支方向"
    },
    {
      "name": "amount",
      "type": "currency",
      "required": true,
      "description": "飞书字段可用货币或数字；数字字段必须设置 formatter=0.00，显示 2 位小数。",
      "feishu_field": "金额"
    },
    {
      "name": "currency",
      "type": "single_select",
      "required": true,
      "allowed_values": [
        "CNY"
      ],
      "feishu_field": "币种"
    },
    {
      "name": "store",
      "type": "text",
      "required": false,
      "feishu_field": "门店"
    },
    {
      "name": "counterparty",
      "type": "text",
      "required": false,
      "feishu_field": "交易对方"
    },
    {
      "name": "category",
      "type": "single_select",
      "required": true,
      "allowed_values": [
        "platform_income",
        "procurement",
        "rent",
        "salary",
        "utility",
        "marketing",
        "refund",
        "transfer",
        "other"
      ],
      "feishu_field": "财务分类"
    },
    {
      "name": "payment_method",
      "type": "single_select",
      "required": false,
      "allowed_values": [
        "wechat_pay",
        "alipay",
        "bank",
        "cash",
        "platform_balance",
        "unknown"
      ],
      "feishu_field": "收付款方式"
    },
    {
      "name": "source_channel",
      "type": "single_select",
      "required": true,
      "feishu_field": "来源渠道"
    },
    {
      "name": "raw_text",
      "type": "multiline_text",
      "required": true,
      "feishu_field": "原始文本"
    },
    {
      "name": "note",
      "type": "multiline_text",
      "required": false,
      "feishu_field": "备注"
    },
    {
      "name": "sync_status",
      "type": "single_select",
      "required": true,
      "allowed_values": [
        "local_only",
        "ready_for_feishu",
        "synced",
        "sync_failed"
      ],
      "feishu_field": "飞书同步状态"
    },
    {
      "name": "sync_marked_ready_at",
      "type": "datetime",
      "required": false,
      "description": "人工标记 ready_for_feishu 的时间，只保存在本地审计记录。"
    },
    {
      "name": "sync_marked_ready_by",
      "type": "text",
      "required": false,
      "description": "人工标记 ready_for_feishu 的操作者，只保存在本地审计记录。"
    },
    {
      "name": "synced_at",
      "type": "datetime",
      "required": false,
      "description": "飞书 API 返回成功后写入的本地同步时间。"
    },
    {
      "name": "feishu_record_id",
      "type": "text",
      "required": false,
      "description": "飞书 API 返回成功后的多维表记录 ID。"
    },
    {
      "name": "sync_error",
      "type": "multiline_text",
      "required": false,
      "description": "飞书同步失败时的错误摘要，不用于声明成功。"
    }
  ],
  "feishu_base_plan": {
    "app_token_env": "FEISHU_FINANCE_APP_TOKEN",
    "app_id_env": "FEISHU_APP_ID",
    "app_secret_env": "FEISHU_APP_SECRET",
    "wiki_token_env": "FEISHU_FINANCE_WIKI_TOKEN",
    "table_id_env": "FEISHU_FINANCE_TABLE_ID",
    "tenant_access_token_env": "FEISHU_TENANT_ACCESS_TOKEN",
    "write_mode_when_tokens_missing": "export_only",
    "sync_script": "scripts/finance_feishu_sync.py",
    "sync_source_filter": "ledger.sync_status == ready_for_feishu",
    "execute_guard": "必须显式传入 --execute 且飞书鉴权、app/wiki/table 环境变量齐全才调用飞书 API。",
    "recommended_tables": [
      {
        "table_name": "财务草稿收件箱",
        "purpose": "接收微信文本和解析结果，只做待确认。"
      },
      {
        "table_name": "财务确认账本",
        "purpose": "只接收人工确认后的 ledger 记录。"
      }
    ]
  }
}
