[Unit]
Description=Daily Order Form
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/daily-order
EnvironmentFile=-/etc/store-order-auth.env
ExecStart=/opt/daily-order/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3
User=ubuntu

[Install]
WantedBy=multi-user.target
