{
  "version": 1,
  "updated_at": "2026-07-03",
  "policy": {
    "execution_agent": "enabled_for_non_ordering_tasks",
    "production_source": "GitHub main",
    "safe_default": "collect_validate_analyze_notify_healthcheck",
    "excluded_domain": "ordering_purchase"
  },
  "pipelines": [
    {
      "id": "daily_automation_guard",
      "name": "每日自动化多 Agent 守护",
      "task_id": "agents.daily_automation_guard",
      "risk_policy": "执行 Agent 可参与非订货任务；订货、下单、采购类动作一律排除。",
      "execution_actions": [
        {
          "id": "refresh_transparency_report",
          "name": "刷新自动化透明化报告",
          "risk": "low",
          "command": ["{python}", "scripts/agent_task_monitor.py"],
          "description": "重新生成自动化任务报告和补跑建议。"
        },
        {
          "id": "refresh_mobile_agent_status",
          "name": "刷新手机 Agent 状态",
          "risk": "low",
          "command": ["{python}", "scripts/build_agent_mobile_status.py"],
          "description": "重新生成手机入口读取的 agent 状态。"
        },
        {
          "id": "safe_rerun_plan",
          "name": "生成安全补跑计划",
          "risk": "low",
          "command": ["{python}", "scripts/agent_rerun_dry_run.py"],
          "description": "生成可补跑清单；不直接触发长时间补跑，订货相关任务保持排除。"
        }
      ],
      "stages": [
        {
          "id": "collect",
          "agent": "collect",
          "name": "采集 Agent",
          "command": ["{python}", "scripts/build_task_health.py"],
          "timeout_seconds": 120,
          "required_outputs": ["outputs/task_health/latest.json"],
          "json_required": [
            {"path": "outputs/task_health/latest.json", "keys": ["generated_at", "tasks"]}
          ],
          "success_message": "已采集当前任务健康信号。"
        },
        {
          "id": "validate",
          "agent": "validate",
          "name": "校验 Agent",
          "required_outputs": [
            "outputs/task_health/latest.json",
            "outputs/task_runs/latest.json"
          ],
          "json_required": [
            {"path": "outputs/task_health/latest.json", "keys": ["generated_at", "tasks"]},
            {"path": "outputs/task_runs/latest.json", "keys": ["generated_at", "tasks"]}
          ],
          "success_message": "关键运行状态和健康产物可读取。"
        },
        {
          "id": "analyze",
          "agent": "analyze",
          "name": "业务判断 Agent",
          "command": ["{python}", "scripts/agent_task_monitor.py"],
          "timeout_seconds": 120,
          "required_outputs": ["outputs/agent_task_monitor/latest.json"],
          "json_required": [
            {"path": "outputs/agent_task_monitor/latest.json", "keys": ["generated_at", "summary", "tasks", "rerun_plan"]}
          ],
          "success_message": "已生成任务透明化分析和补跑建议。"
        },
        {
          "id": "notify",
          "agent": "notify",
          "name": "通知 Agent",
          "required_outputs": ["outputs/agent_task_monitor/latest.txt"],
          "success_message": "已生成可发送的纯文本通知。"
        },
        {
          "id": "healthcheck",
          "agent": "healthcheck",
          "name": "巡检 Agent",
          "required_outputs": [
            "outputs/task_health/latest.json",
            "outputs/agent_task_monitor/latest.json"
          ],
          "success_message": "已完成本轮只读巡检。"
        },
        {
          "id": "execute",
          "agent": "execution",
          "name": "执行 Agent",
          "command": ["{python}", "scripts/agent_execution.py"],
          "timeout_seconds": 900,
          "required_outputs": ["outputs/agent_execution/latest.json"],
          "json_required": [
            {"path": "outputs/agent_execution/latest.json", "keys": ["generated_at", "summary", "actions", "safety"]}
          ],
          "success_message": "执行 Agent 已参与非订货任务，订货/下单/采购类动作已排除。"
        }
      ]
    }
  ]
}
