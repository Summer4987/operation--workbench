  "daily_collection_policy": {
    "schedule": "每日采集昨日和今日新增流水，先生成只读核对结果。",
    "default_mode": "preview_only",
    "sources": [
      "微信支付账单",
      "支付宝账单",
      "银行流水"
    ],
    "reconciliation_priority": [
      "微信/支付宝交易单号和平台订单号、订货订单号精确匹配",
      "微信/支付宝付款记录先匹配订货订单，再和银行出账核对",
      "外卖平台结算先匹配平台收入账单，再和银行入账核对",
      "金额一致、日期相近、对方户名或备注相近时自动建议匹配",
      "多笔合并、手续费差异、退款冲正和跨日到账进入待确认池"
    ],
    "outputs": [
      "每日支付流水核对表",
      "未匹配微信/支付宝付款",
      "未匹配银行入账/出账",
      "门店月度损益表预览",
      "需要人工确认的匹配规则"
    ],
    "blocked_actions": [
      "自动转账",
      "自动付款",
      "自动提交正式财务结果",
      "绕过平台登录或验证码"
    ]
  },
  "matching_policy": {
    "primary_cost_owner": "订货订单先归属门店，微信/支付宝确认支付，银行流水做最终资金核销。",
    "auto_match_priority": [
      "订单号或付款备注精确匹配",
      "金额一致且交易日期在下单日期前后 7 天内",
      "微信/支付宝交易对方或银行摘要命中订单来源、供应商关键词",
      "收货地址、店铺名或手机号命中门店基础表",
      "无法判定时进入待确认池，人工确认后沉淀规则"
    ],
    "amount_tolerance": 1,
    "date_window_days": 7,
    "manual_review_required_when": [
      "一笔付款对应多个门店订单",
      "多个订单合并付款",
      "微信群备注不规范",
      "银行收款方和平台店铺名不一致",
      "金额差异超过容差"
    ]
  },
