      {
        "channel_id": "mini_program_income",
        "reason": "小程序点餐目前无法从银行入账自动区分门店，需要月末手动拆分到 5 家门店。"
      },
      {
        "channel_id": "supply_chain_procurement",
        "reason": "供应链采购一部分供门店使用、一部分用于销售，需要按订单或人工比例拆分。"
      }
    ],
    "third_party_paid_policy": "他人代付先进入代付及往来，月末统一结算后再按对应订单或费用归属账本。",
    "store_procurement_policy": "快驴、淘宝、拼多多、京东采购默认只给门店使用，不归入供应链销售成本，除非订单或人工确认另有说明。"
  }
